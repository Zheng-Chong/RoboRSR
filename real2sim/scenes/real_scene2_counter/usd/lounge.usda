    def "Looks"
    {
        def Material "skirting"
        {
            token outputs:surface.connect = </Lounge/Looks/skirting/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.6, 0.56)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "wood"
        {
            token outputs:surface.connect = </Lounge/Looks/wood/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Lounge/Looks/wood/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/wood.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Lounge/Looks/wood/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "door_seam"
        {
            token outputs:surface.connect = </Lounge/Looks/door_seam/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.03, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "wallpaper"
        {
            token outputs:surface.connect = </Lounge/Looks/wallpaper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Lounge/Looks/wallpaper/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/wallpaper.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Lounge/Looks/wallpaper/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "green_band"
        {
            token outputs:surface.connect = </Lounge/Looks/green_band/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Lounge/Looks/green_band/Texture.outputs:rgb>
                color3f inputs:emissiveColor.connect = </Lounge/Looks/green_band/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/green_band.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Lounge/Looks/green_band/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
