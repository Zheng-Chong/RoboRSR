#usda 1.0
(
    defaultPrim = "Lights"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Lights"
{
    def RectLight "CeilingStrip_0"
    {
        float inputs:colorTemperature = 6000
        bool inputs:enableColorTemperature = 1
        float inputs:height = 0.15
        float inputs:intensity = 54000
        float inputs:width = 1.2
        double3 xformOp:translate = (0, -0.2, 2.78)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def RectLight "CeilingStrip_1"
    {
        float inputs:colorTemperature = 6000
        bool inputs:enableColorTemperature = 1
        float inputs:height = 0.15
        float inputs:intensity = 54000
        float inputs:width = 1.2
        double3 xformOp:translate = (0, -1, 2.78)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def RectLight "CeilingStrip_2"
    {
        float inputs:colorTemperature = 6000
        bool inputs:enableColorTemperature = 1
        float inputs:height = 0.15
        float inputs:intensity = 54000
        float inputs:width = 1.2
        double3 xformOp:translate = (-1.6, -0.6, 2.78)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def RectLight "CeilingStrip_3"
    {
        float inputs:colorTemperature = 6000
        bool inputs:enableColorTemperature = 1
        float inputs:height = 0.15
        float inputs:intensity = 54000
        float inputs:width = 1.2
        double3 xformOp:translate = (1.6, -0.6, 2.78)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "AmbientDome"
    {
        color3f inputs:color = (0.95, 0.95, 1)
        float inputs:intensity = 150
    }
}
