            interpolation = "faceVarying"
        )
        uniform token subdivisionScheme = "none"
    }

    def "Looks"
    {
        def Material "carpet"
        {
            token outputs:surface.connect = </Background/Looks/carpet/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Background/Looks/carpet/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/carpet_tile.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Background/Looks/carpet/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

