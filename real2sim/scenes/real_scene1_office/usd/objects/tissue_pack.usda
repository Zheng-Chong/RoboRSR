    def "Looks"
    {
        def Material "tissue"
        {
            token outputs:surface.connect = </tissue_pack/Looks/tissue/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.66, 0.6, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "tissue_paper"
        {
            token outputs:surface.connect = </tissue_pack/Looks/tissue_paper/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.88, 0.9)
                float inputs:ior = 1.49
                float inputs:metallic = 0
                float inputs:opacity = 0.85
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

