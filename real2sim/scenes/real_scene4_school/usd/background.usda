#usda 1.0
(
    defaultPrim = "Background"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Background"
{
    def Mesh "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        float3[] extent = [(-2.5, -2, -0.1), (2.5, 2.5, 0)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        rel material:binding = </Background/Looks/m0>
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(-2.5, -2, -0.1), (2.5, -2, -0.1), (-2.5, 2.5, -0.1), (2.5, 2.5, -0.1), (-2.5, -2, 0), (2.5, -2, 0), (-2.5, 2.5, 0), (2.5, 2.5, 0)]
        uniform token subdivisionScheme = "none"
    }

    def "Looks"
    {
        def Material "m0"
        {
            token outputs:surface.connect = </Background/Looks/m0/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.4)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "m1"
        {
            token outputs:surface.connect = </Background/Looks/m1/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "m2"
        {
            token outputs:surface.connect = </Background/Looks/m2/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.75, 0.73)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "m3"
        {
            token outputs:surface.connect = </Background/Looks/m3/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0003, 0.0815, 0.0394)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Mesh "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-2.5, -2, 2.8), (2.5, 2.5, 2.85)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        rel material:binding = </Background/Looks/m1>
        point3f[] points = [(-2.5, -2, 2.8), (2.5, -2, 2.8), (-2.5, 2.5, 2.8), (2.5, 2.5, 2.8), (-2.5, -2, 2.85), (2.5, -2, 2.85), (-2.5, 2.5, 2.85), (2.5, 2.5, 2.85)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Wall_left" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-2.55, -2, 0), (-2.5, 2.5, 2.8)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        rel material:binding = </Background/Looks/m2>
        point3f[] points = [(-2.55, -2, 0), (-2.5, -2, 0), (-2.55, 2.5, 0), (-2.5, 2.5, 0), (-2.55, -2, 2.8), (-2.5, -2, 2.8), (-2.55, 2.5, 2.8), (-2.5, 2.5, 2.8)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Wall_right" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(2.5, -2, 0), (2.55, 2.5, 2.8)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        rel material:binding = </Background/Looks/m2>
        point3f[] points = [(2.5, -2, 0), (2.55, -2, 0), (2.5, 2.5, 0), (2.55, 2.5, 0), (2.5, -2, 2.8), (2.55, -2, 2.8), (2.5, 2.5, 2.8), (2.55, 2.5, 2.8)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Wall_back" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-2.5, -2.05, 0), (2.5, -2, 2.8)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        rel material:binding = </Background/Looks/m2>
        point3f[] points = [(-2.5, -2.05, 0), (2.5, -2.05, 0), (-2.5, -2, 0), (2.5, -2, 0), (-2.5, -2.05, 2.8), (2.5, -2.05, 2.8), (-2.5, -2, 2.8), (2.5, -2, 2.8)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Wall_front" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-2.5, 2.5, 0), (2.5, 2.55, 2.8)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        rel material:binding = </Background/Looks/m2>
        point3f[] points = [(-2.5, 2.5, 0), (2.5, 2.5, 0), (-2.5, 2.55, 0), (2.5, 2.55, 0), (-2.5, 2.5, 2.8), (2.5, 2.5, 2.8), (-2.5, 2.55, 2.8), (2.5, 2.55, 2.8)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Backdrop" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-1.0559344, 0.24890934, 0.2855861), (0.91397804, 0.45717323, 2.285586)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        rel material:binding = </Background/Looks/m3>
        point3f[] points = [(-1.054029, 0.24890934, 0.2855861), (0.91397804, 0.4372642, 0.2855861), (-1.0559344, 0.26881838, 0.2855861), (0.91207254, 0.45717323, 0.2855861), (-1.054029, 0.24890934, 2.285586), (0.91397804, 0.4372642, 2.285586), (-1.0559344, 0.26881838, 2.285586), (0.91207254, 0.45717323, 2.285586)]
        uniform token subdivisionScheme = "none"
    }
}
