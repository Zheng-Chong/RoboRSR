# Python
**/__pycache__/
**/*.egg-info
.ruff_cache/

# Downloaded assets (populated by scripts/init_assets.sh)
/Assets/*
# Self-built assets that cannot be regenerated (binaries via Git LFS, see .gitattributes)
!/Assets/scene3_pour_pack/
/Assets/scene3_pour_pack/preview/
/Assets/scene3_pour_pack/**/*.bak

# Evaluation + smoke run outputs (regenerated by robodojo.sh)
eval_result/
smoke_results/
docker/smoke_logs/
data/

# Local scratch
Dev/
ignore/
.cache/

# Editor / agent scratch (never committed)
.cursor/
.claude/
Untitled
