def Xform "World"
{
    def Xform "Table" (
        prepend references = @./table.usdc@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "source_cup" (
        prepend references = @./objects/source_cup.usdc@
