#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Table" (
        prepend references = @./table.usdc@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "source_cup" (
        prepend references = @./objects/source_cup.usdc@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (-0.16, -0.105, 0.751)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "receiver_cup" (
        prepend references = @./objects/receiver_cup.usdc@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (-0.16, 0.1, 0.751)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "basket_right" (
        prepend references = @./objects/basket_right.usdc@
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.015, -0.415, 0.751)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "basket_left" (
        prepend references = @./objects/basket_left.usdc@
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.015, 0.415, 0.751)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "toy" (
        prepend references = @./objects/toy.usdc@
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (0.9659258, 0, 0, 0.25881904)
        double3 xformOp:translate = (0.125, -0.085, 0.751)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "paper" (
        prepend references = @./objects/paper.usdc@
    )
    {
        bool physics:kinematicEnabled = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.125, 0.13, 0.751)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom token physxScene:broadphaseType = "GPU"
        custom bool physxScene:enableCCD = 1
        custom bool physxScene:enableGPUDynamics = 1
        custom token physxScene:solverType = "TGS"
        custom uint physxScene:timeStepsPerSecond = 240
    }

    def "Lighting"
    {
        def DomeLight "Fill"
        {
            color3f inputs:color = (0.89, 0.94, 1)
            float inputs:intensity = 650
        }

        def RectLight "Key"
        {
            float inputs:height = 1.1
            float inputs:intensity = 1800
            float inputs:width = 1.3
            double3 xformOp:translate = (-0.6, -0.6, 2.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def RectLight "Softbox"
        {
            float inputs:height = 1.2
            float inputs:intensity = 900
            float inputs:width = 0.7
            double3 xformOp:translate = (0.8, 0.6, 2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def "Cameras"
    {
        def Camera "Overview"
        {
            float2 clippingRange = (0.02, 100)
            float focalLength = 35
            matrix4d xformOp:transform = ( (0.6866235329637165, -0.7270131525498175, -2.7755575615628907e-17, 0), (0.26044198858758777, 0.24597298922161065, 0.9336312222467327, 0), (-0.6787621782045364, -0.6410531683042844, 0.35823559405239425, 0), (-1.8999999999999997, -1.6999999999999997, 1.65, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}

